# Copy to .env and fill in. Everything is optional: with no values the site runs in DEMO mode (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Razorpay TEST key id (rzp_test_...). Leave empty to keep checkout in clearly-labelled demo mode.
VITE_RAZORPAY_KEY_ID=
# Local development only: lets you open /admin in demo mode (no Supabase). Never enable in production.
VITE_DEMO_ADMIN=false
